# Environment Variables Template

# Copy this file to .env.local and fill in your actual values
# This file should NEVER be committed to version control

# ════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION
# ════════════════════════════════════════════════════════════
# Get these from: https://app.supabase.com > Project Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ════════════════════════════════════════════════════════════
# GOOGLE GEMINI AI API
# ════════════════════════════════════════════════════════════
# Get from: https://aistudio.google.com/app/apikeys

GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key-here

# ════════════════════════════════════════════════════════════
# EMAIL SERVICE (RESEND)
# ════════════════════════════════════════════════════════════
# Get from: https://resend.com/api-keys

# Leave empty when using the connected Resend integration instead of a direct API key.
RESEND_API_KEY=
# Or use the existing Resend integration variables RESEND_EMAIL_RESEND_API_KEY and RESEND_EMAIL_DOMAIN.
# RESEND_EMAIL_DOMAIN must be a verified plain domain (no scheme or email address); defaults to eva-tech-studio.com.
# RESEND_EMAIL_DOMAIN=eva-tech-studio.com
# CONTACT_TO_EMAIL is optional and defaults to info@eva-tech-studio.com.
CONTACT_TO_EMAIL=info@eva-tech-studio.com

# ════════════════════════════════════════════════════════════
# AUTHENTICATION
# ════════════════════════════════════════════════════════════
# Authorized admin email - comma-separated for multiple admins

AUTHORIZED_EMAIL=your-email@example.com

# ════════════════════════════════════════════════════════════
# CAREERS AUTOMATION (SERVER-ONLY)
# ════════════════════════════════════════════════════════════

# Random secrets used by the WhatsApp webhook and scheduled worker
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
AUTOMATION_WORKER_SECRET=replace-with-a-different-random-worker-secret

# Meta WhatsApp Cloud API; sending is deliberately disabled until explicitly enabled
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_API_VERSION=vXX.Y
WHATSAPP_TEMPLATE_NAME=approved_job_announcement
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_SEND_ENABLED=false

# ════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ════════════════════════════════════════════════════════════

# Node environment
NODE_ENV=development

# Application domain (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.eva-tech-studio.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Enable secure cookies (set to true in production)
SECURE_COOKIES=false

# ════════════════════════════════════════════════════════════
# ANALYTICS & MONITORING (Optional)
# ════════════════════════════════════════════════════════════

# Sentry (error tracking)
# SENTRY_DSN=

# PostHog (analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT NOTES
# ════════════════════════════════════════════════════════════

# 1. Before deploying to production:
#    - Set NODE_ENV=production
#    - Set SECURE_COOKIES=true
#    - Set NEXT_PUBLIC_APP_URL to your actual domain
#    - Ensure all API keys are set
#    - Apply supabase/migrations/008_careers_automation.sql
#    - Keep SUPABASE_SERVICE_ROLE_KEY server-only; never prefix it with NEXT_PUBLIC_
#    - Configure a scheduled POST to /api/automation/process with
#      Authorization: Bearer <AUTOMATION_WORKER_SECRET>
#    - Enable WhatsApp sends only after opting in a test number and approving the template

# 2. Configure in your hosting provider's environment variables:
#    - Vercel: https://vercel.com/docs/projects/environment-variables
#    - Railway: https://docs.railway.app/develop/variables
#    - Netlify: https://docs.netlify.com/site-configuration/environment-variables

# 3. Never commit .env.local to version control
#    .gitignore should already exclude it

# 4. For production security, also set up:
#    - Rate limiting (Upstash Redis recommended)
#    - CORS configuration
#    - Content Security Policy headers
#    - HTTPS enforcement
